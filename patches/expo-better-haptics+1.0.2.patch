+        // playAHAP と同じだが、パターンが鳴り終わってから resolve する（iphone-haptic 用パッチ）。
+        // playAHAP は player.start 直後に返るため、JS 側で await しても再生終了を待てない
+        AsyncFunction("playAHAPAndWait") { (ahapData: [CHHapticPattern.Key: Any], promise: Promise) in
+            guard let engine = self.engine, self.supportsHaptics else {
+                promise.resolve(false)
+                return
+            }
+
+            do {
+                let pattern = try CHHapticPattern(dictionary: ahapData)
+                let player = try engine.makeAdvancedPlayer(with: pattern)
+                let key = ObjectIdentifier(player)
+
+                player.completionHandler = { [weak self] error in
+                    if let error = error {
+                        print("AHAP pattern finished with error: \(error)")
+                    }
+                    self?.waitingPlayersLock.lock()
+                    self?.waitingPlayers.removeValue(forKey: key)
+                    self?.waitingPlayersLock.unlock()
+                    promise.resolve(error == nil)
+                }
+
+                self.waitingPlayersLock.lock()
+                self.waitingPlayers[key] = player
+                self.waitingPlayersLock.unlock()
+
+                try engine.start()
+                try player.start(atTime: CHHapticTimeImmediate)
+            } catch {
